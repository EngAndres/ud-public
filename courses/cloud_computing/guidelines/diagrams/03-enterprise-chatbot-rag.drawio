<mxfile host="app.diagrams.net"><diagram name="Guide 3: Enterprise Chatbot with RAG" id="arch"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="798" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="aws" value="AWS Cloud (one region)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#7D8998;verticalAlign=top;align=right;spacingLeft=8;spacingRight=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="275" y="20" width="1285" height="520" as="geometry"/></mxCell><mxCell id="adm" value="uploads policy files&lt;br&gt;start-ingestion-job" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5F6B7A;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="160" height="76" as="geometry"/></mxCell><mxCell id="adm_h" value="Admin" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#5F6B7A;strokeColor=#5F6B7A;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="adm"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="s3" value="docs bucket&lt;br&gt;deployed from ./docs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="160" height="76" as="geometry"/></mxCell><mxCell id="s3_h" value="Amazon S3" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=#7AA116;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="s3"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="kb" value="chunks documents&lt;br&gt;(default strategy)&lt;br&gt;Retrieve API" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="160" height="76" as="geometry"/></mxCell><mxCell id="kb_h" value="Bedrock Knowledge Base" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#01A88D;fontColor=#ffffff;fontStyle=1;fontSize=11.1;" vertex="1" parent="kb"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="emb" value="V2 (via the KB)&lt;br&gt;text -&amp;gt; vector" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="840" y="70" width="160" height="76" as="geometry"/></mxCell><mxCell id="emb_h" value="Titan Text Embeddings" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#01A88D;fontColor=#ffffff;fontStyle=1;fontSize=11.6;" vertex="1" parent="emb"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="oss" value="vector collection&lt;br&gt;created by the construct" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C925D1;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="1110" y="70" width="160" height="76" as="geometry"/></mxCell><mxCell id="oss_h" value="OpenSearch Serverless" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=#C925D1;fontColor=#ffffff;fontStyle=1;fontSize=11.6;" vertex="1" parent="oss"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="emp" value="SigV4-signed&lt;br&gt;POST /ask" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5F6B7A;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="160" height="76" as="geometry"/></mxCell><mxCell id="emp_h" value="Employee" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#5F6B7A;strokeColor=#5F6B7A;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="emp"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="api" value="IAM authorization&lt;br&gt;throttle 5 rps / burst 10" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="300" y="270" width="160" height="76" as="geometry"/></mxCell><mxCell id="api_h" value="API Gateway (REST)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#8C4FFF;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="api"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="fn" value="Retrieve + Converse&lt;br&gt;drops chunks &amp;lt; MIN_SCORE&lt;br&gt;timeout 29 s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="570" y="270" width="160" height="76" as="geometry"/></mxCell><mxCell id="fn_h" value="Lambda: ChatFn" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#ED7100;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="fn"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="llm" value="Converse API&lt;br&gt;answers from context only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="840" y="270" width="160" height="76" as="geometry"/></mxCell><mxCell id="llm_h" value="Bedrock foundation model" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#01A88D;fontColor=#ffffff;fontStyle=1;fontSize=10.1;" vertex="1" parent="llm"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="gr" value="content filters, denied&lt;br&gt;topic, PII anonymize" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#DD344C;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="840" y="390" width="160" height="76" as="geometry"/></mxCell><mxCell id="gr_h" value="Bedrock Guardrails" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#DD344C;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="gr"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="iam" value="bedrock:Retrieve (KB ARN)&lt;br&gt;InvokeModel (model ARN)&lt;br&gt;ApplyGuardrail (ARN)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#DD344C;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="300" y="410" width="170" height="76" as="geometry"/></mxCell><mxCell id="iam_h" value="IAM role" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#DD344C;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="iam"><mxGeometry width="170" height="24" as="geometry"/></mxCell><mxCell id="cw" value="7-day retention&lt;br&gt;guardrail trace logged" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E7157B;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="570" y="410" width="160" height="76" as="geometry"/></mxCell><mxCell id="cw_h" value="CloudWatch Logs" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=#E7157B;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="cw"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="e0" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="adm" target="s3"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e1" value="data source" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s3" target="kb"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" value="embed chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="kb" target="emb"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e3" value="store vectors" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="emb" target="oss"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e4" value="start-ingestion-job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="adm" target="kb"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="110.0" y="50.0"/><mxPoint x="650.0" y="50.0"/></Array></mxGeometry></mxCell><mxCell id="e5" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="emp" target="api"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e6" value="proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="api" target="fn"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e7" value="Retrieve (top 4)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="fn" target="kb"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e8" value="Converse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="fn" target="llm"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e9" value="input / output check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="llm" target="gr"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e10" value="logs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="fn" target="cw"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c101" value="Ingestion (per document change)" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#01796B;" vertex="1" parent="1"><mxGeometry x="1300" y="88" width="600" height="18" as="geometry"/></mxCell><mxCell id="c102" value="Question answering (per request)" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#01796B;" vertex="1" parent="1"><mxGeometry x="1300" y="288" width="600" height="18" as="geometry"/></mxCell><mxCell id="c103" value="Guide 3: Enterprise Chatbot with RAG" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="13" width="600" height="23" as="geometry"/></mxCell><mxCell id="c104" value="Solid arrow: call or data write   |   Dashed arrow: trigger, async event or optional path   |   Numbered circles match the Flow list" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="24" y="567" width="600" height="17" as="geometry"/></mxCell><mxCell id="c105" value="Flow" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="587" width="600" height="19" as="geometry"/></mxCell><mxCell id="c106" value="1.  An admin uploads the policy files to S3 and runs start-ingestion-job (CDK does not start it)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="610" width="600" height="18" as="geometry"/></mxCell><mxCell id="c107" value="2.  The knowledge base splits each document into chunks and asks Titan Text Embeddings V2 for a vector per chunk." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="629" width="600" height="18" as="geometry"/></mxCell><mxCell id="c108" value="3.  The vectors are stored in an OpenSearch Serverless index. The same path serves the semantic search at query time." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="648" width="600" height="18" as="geometry"/></mxCell><mxCell id="c109" value="4.  An employee sends a SigV4-signed POST /ask. API Gateway checks IAM and throttles to protect the model budget." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="667" width="600" height="18" as="geometry"/></mxCell><mxCell id="c110" value="5.  ChatFn calls Retrieve (top 4) and drops chunks below MIN_SCORE; if nothing is left it answers &quot;not found&quot; without calling the model." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="686" width="600" height="18" as="geometry"/></mxCell><mxCell id="c111" value="6.  ChatFn calls Converse with the chunks as context. The question is sent as guardContent so the filters evaluate it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="705" width="600" height="18" as="geometry"/></mxCell><mxCell id="c112" value="7.  The guardrail checks input and output (content filters, denied topic, PII). A block returns stopReason guardrail_intervened." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="724" width="600" height="18" as="geometry"/></mxCell><mxCell id="c113" value="8.  The API returns the answer, the sources (S3 URI and score) and guardrailAction ALLOWED or BLOCKED." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="743" width="600" height="18" as="geometry"/></mxCell><mxCell id="c114" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="21" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c115" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="561" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c116" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1101" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c117" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="291" y="261" width="20" height="20" as="geometry"/></mxCell><mxCell id="c118" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="561" y="261" width="20" height="20" as="geometry"/></mxCell><mxCell id="c119" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="831" y="261" width="20" height="20" as="geometry"/></mxCell><mxCell id="c120" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="831" y="381" width="20" height="20" as="geometry"/></mxCell><mxCell id="c121" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="21" y="261" width="20" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>