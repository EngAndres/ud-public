id="c102" value="Guide 6: Resilient Web Application" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="13" width="600" height="23" as="geometry"/></mxCell><mxCell id="c103" value="Solid arrow: call or data write   |   Dashed arrow: trigger, async event or optional path   |   Numbered circles match the Flow list" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="24" y="807" width="600" height="17" as="geometry"/></mxCell><mxCell id="c104" value="Flow" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="827" width="600" height="19" as="geometry"/></mxCell><mxCell id="c105" value="1.  A user requests https://&lt;edge-domain&gt;; HTTP is redirected to HTTPS and TLS ends at CloudFront." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="850" width="600" height="18" as="geometry"/></mxCell><mxCell id="c106" value="2.  WAF inspects every request at the edge: a rate limit per IP and the Common and SQL-injection managed rule groups (403 when blocked)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="869" width="600" height="18" as="geometry"/></mxCell><mxCell id="c107" value="3.  CloudFront forwards dynamic requests to the ALB (caching disabled) and caches /static/* at the edge to absorb traffic peaks." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="888" width="600" height="18" as="geometry"/></mxCell><mxCell id="c108" value="4.  The ALB accepts traffic only from CloudFront and sends it to healthy targets in both AZs; it removes failing targets." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="907" width="600" height="18" as="geometry"/></mxCell><mxCell id="c109" value="5.  Fargate tasks in private subnets serve the request. ECS replaces a failed task and auto scaling keeps 2 to 6 tasks." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="926" width="600" height="18" as="geometry"/></mxCell><mxCell id="c110" value="6.  Tasks use PostgreSQL (synchronous standby, automatic failover) and Redis (replica promoted on failure) in isolated subnets." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="945" width="600" height="18" as="geometry"/></mxCell><mxCell id="c111" value="7.  Tasks reach the internet (image pull) through one NAT gateway per AZ, so one AZ failure does not cut outbound traffic." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="964" width="600" height="18" as="geometry"/></mxCell><mxCell id="c112" value="8.  CloudWatch alarms on ELB 5XX, target 5XX and unhealthy hosts notify the operator through SNS email. Nobody has to act to recover." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="983" width="600" height="18" as="geometry"/></mxCell><mxCell id="c113" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="21" y="251" width="20" height="20" as="geometry"/></mxCell><mxCell id="c114" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="226" y="401" width="20" height="20" as="geometry"/></mxCell><mxCell id="c115" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="226" y="251" width="20" height="20" as="geometry"/></mxCell><mxCell id="c116" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="536" y="181" width="20" height="20" as="geometry"/></mxCell><mxCell id="c117" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="536" y="391" width="20" height="20" as="geometry"/></mxCell><mxCell id="c118" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="536" y="553" width="20" height="20" as="geometry"/></mxCell><mxCell id="c119" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="546" y="271" width="20" height="20" as="geometry"/></mxCell><mxCell id="c120" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1431" y="181" width="20" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>