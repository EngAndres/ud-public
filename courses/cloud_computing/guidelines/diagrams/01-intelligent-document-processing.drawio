y x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="625.0" y="150.0"/><mxPoint x="345.0" y="150.0"/></Array></mxGeometry></mxCell><mxCell id="e3" value="AnalyzeDocument" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.2;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="fn" target="tx"><mxGeometry x="0.492" relative="1" as="geometry"><Array as="points"><mxPoint x="745.0" y="215.0"/><mxPoint x="745.0" y="100.0"/></Array></mxGeometry></mxCell><mxCell id="e4" value="DetectEntities" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="fn" target="cmp"><mxGeometry x="-0.510" relative="1" as="geometry"><Array as="points"><mxPoint x="805.0" y="245.0"/><mxPoint x="805.0" y="241.0"/></Array></mxGeometry></mxCell><mxCell id="e5" value="PutItem" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.7;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="fn" target="ddb"><mxGeometry x="0.561" relative="1" as="geometry"><Array as="points"><mxPoint x="775.0" y="265.0"/><mxPoint x="775.0" y="360.0"/></Array></mxGeometry></mxCell><mxCell id="e6" value="Publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.85;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="fn" target="sns"><mxGeometry x="0.583" relative="1" as="geometry"><Array as="points"><mxPoint x="745.0" y="280.0"/><mxPoint x="745.0" y="462.0"/></Array></mxGeometry></mxCell><mxCell id="e7" value="email" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="sns" target="rev"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e8" value="failed invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="fn" target="dlq"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e9" value="assumes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.85;entryPerimeter=0;" edge="1" parent="1" source="iam" target="fn"><mxGeometry x="0.037" relative="1" as="geometry"><Array as="points"><mxPoint x="490.0" y="442.0"/><mxPoint x="490.0" y="280.0"/></Array></mxGeometry></mxCell><mxCell id="c101" value="Rule: form fields found AND average confidence &gt;= 90  -&gt;  AUTO_APPROVED, otherwise NEEDS_REVIEW" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="260" y="500" width="600" height="18" as="geometry"/></mxCell><mxCell id="c102" value="Guide 1: Intelligent Document Processing" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="13" width="600" height="23" as="geometry"/></mxCell><mxCell id="c103" value="Solid arrow: call or data write   |   Dashed arrow: trigger, async event or optional path   |   Numbered circles match the Flow list" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="24" y="527" width="600" height="17" as="geometry"/></mxCell><mxCell id="c104" value="Flow" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="547" width="600" height="19" as="geometry"/></mxCell><mxCell id="c105" value="1.  A requester uploads a PNG or JPEG to requests/ (a different prefix from results/, so the output never re-triggers the function)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="570" width="600" height="18" as="geometry"/></mxCell><mxCell id="c106" value="2.  S3 ObjectCreated invokes ProcessDocumentFn. S3 delivers events at least once, so the item is keyed by requestId and is idempotent." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="589" width="600" height="18" as="geometry"/></mxCell><mxCell id="c107" value="3.  Textract AnalyzeDocument (synchronous, one page) returns lines, key/value pairs and tables." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="608" width="600" height="18" as="geometry"/></mxCell><mxCell id="c108" value="4.  Comprehend DetectEntities runs on the extracted text (names, dates, amounts, organizations)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="627" width="600" height="18" as="geometry"/></mxCell><mxCell id="c109" value="5.  The function applies the decision rule: average confidence of LINE and KEY_VALUE_SET blocks, and at least one form field." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="646" width="600" height="18" as="geometry"/></mxCell><mxCell id="c110" value="6.  It writes results/&lt;id&gt;.json to S3 and one DynamoDB item with the status, the confidence and the extracted fields." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="665" width="600" height="18" as="geometry"/></mxCell><mxCell id="c111" value="7.  NEEDS_REVIEW publishes to SNS; the reviewer gets an email. Invocations that keep failing land in the dead-letter queue." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="684" width="600" height="18" as="geometry"/></mxCell><mxCell id="c112" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="21" y="194" width="20" height="20" as="geometry"/></mxCell><mxCell id="c113" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="531" y="186" width="20" height="20" as="geometry"/></mxCell><mxCell id="c114" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="891" y="53" width="20" height="20" as="geometry"/></mxCell><mxCell id="c115" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="891" y="194" width="20" height="20" as="geometry"/></mxCell><mxCell id="c116" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="891" y="313" width="20" height="20" as="geometry"/></mxCell><mxCell id="c117" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="891" y="415" width="20" height="20" as="geometry"/></mxCell><mxCell id="c118" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="689" y="186" width="20" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>