<mxfile host="app.diagrams.net"><diagram name="Guide 1: Intelligent Document Processing" id="arch"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="739" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="aws" value="AWS Cloud (one region)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#7D8998;verticalAlign=top;align=right;spacingLeft=8;spacingRight=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="235" y="44" width="880" height="480" as="geometry"/></mxCell><mxCell id="req" value="Scanned forms&lt;br&gt;PNG or JPEG" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5F6B7A;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="30" y="203" width="170" height="76" as="geometry"/></mxCell><mxCell id="req_h" value="Requesters" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#5F6B7A;strokeColor=#5F6B7A;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="req"><mxGeometry width="170" height="24" as="geometry"/></mxCell><mxCell id="s3" value="requests/ (input)&lt;br&gt;results/ (JSON output)&lt;br&gt;encrypted, versioned" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="260" y="195" width="170" height="100" as="geometry"/></mxCell><mxCell id="s3_h" value="Amazon S3" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=#7AA116;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="s3"><mxGeometry width="170" height="24" as="geometry"/></mxCell><mxCell id="fn" value="Node.js 22, 512 MB, 60 s&lt;br&gt;orchestrates and decides&lt;br&gt;least-p