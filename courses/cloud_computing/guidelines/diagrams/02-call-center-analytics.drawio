Style=1;fontSize=12.5;" vertex="1" parent="ddb"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="sup" value="negative calls first&lt;br&gt;QuickSight: extension" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5F6B7A;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="1380" y="330" width="160" height="76" as="geometry"/></mxCell><mxCell id="sup_h" value="Supervisor" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#5F6B7A;strokeColor=#5F6B7A;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="sup"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="e0" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="call" target="s3"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e1" value="event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s3" target="st"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" value="StartJob" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="st" target="tr"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e3" value="state change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="tr" target="eb"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e4" value="transcripts/&lt;job&gt;.json" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="tr" target="s3"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="920.0" y="52.0"/><mxPoint x="380.0" y="52.0"/></Array></mxGeometry></mxCell><mxCell id="e5" value="invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="eb" target="an"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e6" value="sentiment, PII" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=0;exitY=0.2;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="an" target="cmp"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="1055.0" y="247.0"/><mxPoint x="1055.0" y="238.0"/></Array></mxGeometry></mxCell><mxCell id="e7" value="summary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=0;exitY=0.75;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="an" target="br"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="1055.0" y="335.0"/><mxPoint x="1055.0" y="338.0"/></Array></mxGeometry></mxCell><mxCell id="e8" value="PutItem" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="an" target="ddb"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="1325.0" y="295.0"/><mxPoint x="1325.0" y="253.0"/></Array></mxGeometry></mxCell><mxCell id="e9" value="Query GSI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="ddb" target="sup"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e10" value="GetObject transcripts/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="s3" target="an"><mxGeometry x="0.196" relative="1" as="geometry"><Array as="points"><mxPoint x="380.0" y="440.0"/><mxPoint x="1190.0" y="440.0"/></Array></mxGeometry></mxCell><mxCell id="c101" value="Guide 2: Call-Center Analytics" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="13" width="600" height="23" as="geometry"/></mxCell><mxCell id="c102" value="Solid arrow: call or data write   |   Dashed arrow: trigger, async event or optional path   |   Numbered circles match the Flow list" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="24" y="507" width="600" height="17" as="geometry"/></mxCell><mxCell id="c103" value="Flow" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="527" width="600" height="19" as="geometry"/></mxCell><mxCell id="c104" value="1.  A recording (.mp3 or .wav) is uploaded to audio/." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="550" width="600" height="18" as="geometry"/></mxCell><mxCell id="c105" value="2.  S3 invokes StartTranscriptionFn, which starts a Transcribe batch job with speaker labels. The job name carries the call id." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="569" width="600" height="18" as="geometry"/></mxCell><mxCell id="c106" value="3.  Transcribe writes transcripts/&lt;job&gt;.json to the same bucket (a different prefix, so there is no loop)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="588" width="600" height="18" as="geometry"/></mxCell><mxCell id="c107" value="4.  Transcribe emits &quot;Job State Change = COMPLETED&quot;. The EventBridge rule filters on the call- prefix and invokes AnalyzeTranscriptFn: no polling." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="607" width="600" height="18" as="geometry"/></mxCell><mxCell id="c108" value="5.  The function reads the transcript and calls Comprehend for the sentiment and the personal data (PII) entities." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="626" width="600" height="18" as="geometry"/></mxCell><mxCell id="c109" value="6.  PII spans are masked, then Bedrock Converse writes a three-sentence summary (model id is a context value)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="645" width="600" height="18" as="geometry"/></mxCell><mxCell id="c110" value="7.  One DynamoDB item per call: sentiment, scores, PII types, summary, priority (HIGH when NEGATIVE)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="664" width="600" height="18" as="geometry"/></mxCell><mxCell id="c111" value="8.  Supervisors query the bySentiment index, newest first. A QuickSight dashboard on the index is the extension." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="683" width="600" height="18" as="geometry"/></mxCell><mxCell id="c112" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="21" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c113" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="561" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c114" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="831" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c115" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1101" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c116" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="831" y="191" width="20" height="20" as="geometry"/></mxCell><mxCell id="c117" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="831" y="291" width="20" height="20" as="geometry"/></mxCell><mxCell id="c118" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1371" y="206" width="20" height="20" as="geometry"/></mxCell><mxCell id="c119" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1371" y="321" width="20" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>