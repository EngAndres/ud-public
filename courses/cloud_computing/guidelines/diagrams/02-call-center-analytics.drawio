<mxfile host="app.diagrams.net"><diagram name="Guide 2: Call-Center Analytics" id="arch"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="738" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="aws" value="AWS Cloud (one region)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#7D8998;verticalAlign=top;align=right;spacingLeft=8;spacingRight=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="275" y="20" width="1285" height="470" as="geometry"/></mxCell><mxCell id="call" value=".mp3 / .wav&lt;br&gt;under 2 minutes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5F6B7A;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="160" height="76" as="geometry"/></mxCell><mxCell id="call_h" value="Customer calls" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#5F6B7A;strokeColor=#5F6B7A;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="call"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="s3" value="audio/  transcripts/&lt;br&gt;encrypted, private" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="160" height="76" as="geometry"/></mxCell><mxCell id="s3_h" value="Amazon S3" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=#7AA116;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="s3"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="st" value="starts the job&lt;br&gt;name: call-&amp;lt;id&amp;gt;-&amp;lt;time&amp;gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="160" height="76" as="geometry"/></mxCell><mxCell id="st_h" value="Lambda: StartTranscription" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#ED7100;fontColor=#ffffff;fontStyle=1;fontSize=9.4;" vertex="1" parent="st"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="tr" value="batch job, en-US&lt;br&gt;speaker labels (2)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="840" y="70" width="160" height="76" as="geometry"/></mxCell><mxCell id="tr_h" value="Amazon Transcribe" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#01A88D;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="tr"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="eb" value="Job State Change&lt;br&gt;COMPLETED, prefix call-" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E7157B;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="1110" y="70" width="160" height="76" as="geometry"/></mxCell><mxCell id="eb_h" value="EventBridge rule" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=#E7157B;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="eb"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="an" value="reads the transcript&lt;br&gt;masks PII&lt;br&gt;writes the item" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="111