<mxfile host="app.diagrams.net"><diagram name="Guide 5: Custom ML Model with SageMaker" id="arch"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="738" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="aws" value="AWS Cloud (one region)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#7D8998;verticalAlign=top;align=right;spacingLeft=8;spacingRight=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="275" y="20" width="1285" height="480" as="geometry"/></mxCell><mxCell id="dev" value="awk: train.csv (400)&lt;br&gt;validation.csv (100)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5F6B7A;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="160" height="76" as="geometry"/></mxCell><mxCell id="dev_h" value="Developer" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#5F6B7A;strokeColor=#5F6B7A;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="dev"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="s3" value="train/  validation/&lt;br&gt;models/  captured/&lt;br&gt;encrypted, private" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="160" height="100" as="geometry"/></mxCell><mxCell id="s3_h" value="Amazon S3: data bucket" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=#7AA116;fontColor=#ffffff;fontStyle=1;fontSize=11.1;" vertex="1" parent="s3"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="trn" value="built-in XGBoost 1.7-1&lt;br&gt;ml.m5.large, max 900 s&lt;br&gt;binary:logistic, AUC" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="160" height="100" as="geometry"/></mxCell><mxCell id="trn_h" value="SageMaker training job" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#01A88D;fontColor=#ffffff;fontStyle=1;fontSize=11.1;" vertex="1" parent="trn"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="ev" value="validation:auc from&lt;br&gt;describe-training-job&lt;br&gt;deploy only if &amp;gt;= 0.90" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E7157B;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="840" y="70" width="160" height="100" as="geometry"/></mxCell><mxCell id="ev_h" value="Evaluate (gate)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=#E7157B;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="ev"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="ep" value="CfnModel + EndpointConfig&lt;br&gt;ml.t2.medium x1&lt;br&gt;created by cdk deploy" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="1110" y="70" width="160" height="100" as="geometry"/></mxCell><mxCell id="ep_h" value="SageMaker endpoint" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#01A88D;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="ep"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="app" value="InvokeEndpoint&lt;br&gt;text/csv, no label" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5F6B7A;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="1380" y="70" width="160" height="100" as="geometry"/></mxCell><mxCell id="app_h" value="Application" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#5F6B7A;strokeColor=#5F6B7A;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="app"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="cap" value="100% of requests&lt;br&gt;and responses" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="1110" y="270" width="160" height="76" as="geometry"/></mxCell><mxCell id="cap_h" value="Data capture" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#01A88D;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="cap"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="eb" value="rate(7 days)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E7157B;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="840" y="270" width="160" height="76" as="geometry"/></mxCell><mxCell id="eb_h" value="EventBridge rule" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=#E7157B;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="eb"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="rt" value="CreateTrainingJob&lt;br&gt;same channels as step 2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="570" y="270" width="160" height="76" as="geometry"/></mxCell><mxCell id="rt_h" value="Lambda: RetrainFn" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#ED7100;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="rt"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="iam" value="S3 read/write, ECR pull,&lt;br&gt;CloudWatch logs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#DD344C;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="160" height="76" as="geometry"/></mxCell><mxCell id="iam_h" value="SageMaker execution role" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#DD344C;fontColor=#ffffff;fontStyle=1;fontSize=10.1;" vertex="1" parent="iam"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="e0" value="BucketDeployment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="dev" target="s3"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="245.0" y="108.0"/><mxPoint x="245.0" y="120.0"/></Array></mxGeometry></mxCell><mxCell id="e1" value="channels" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s3" target="trn"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" value="model.tar.gz -&gt; models/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="trn" target="s3"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="650.0" y="52.0"/><mxPoint x="380.0" y="52.0"/></Array></mxGeometry></mxCell><mxCell id="e3" value="Completed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="trn" target="ev"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e4" value="cdk deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="ev" target="ep"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e5" value="probability" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="ep" target="app"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e6" value="capture" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="ep" target="cap"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e7" value="captured/ JSON (batched)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="cap" target="s3"><mxGeometry x="-0.155" relative="1" as="geometry"><Array as="points"><mxPoint x="1190.0" y="420.0"/><mxPoint x="380.0" y="420.0"/></Array></mxGeometry></mxCell><mxCell id="e8" value="every 7 days" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=0;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="eb" target="rt"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e9" value="new job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="rt" target="trn"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c101" value="Cost: the endpoint bills every hour it exists. Destroy the stack after the lab." style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="290" y="458" width="600" height="18" as="geometry"/></mxCell><mxCell id="c102" value="Guide 5: Custom ML Model with SageMaker" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="13" width="600" height="23" as="geometry"/></mxCell><mxCell id="c103" value="Solid arrow: call or data write   |   Dashed arrow: trigger, async event or optional path   |   Numbered circles match the Flow list" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="24" y="507" width="600" height="17" as="geometry"/></mxCell><mxCell id="c104" value="Flow" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="527" width="600" height="19" as="geometry"/></mxCell><mxCell id="c105" value="1.  The developer generates the CSV files (label in the first column, no header) and CDK uploads them to train/ and validation/." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="550" width="600" height="18" as="geometry"/></mxCell><mxCell id="c106" value="2.  A training job (built-in XGBoost, no custom container) reads both channels and writes model.tar.gz to models/." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="569" width="600" height="18" as="geometry"/></mxCell><mxCell id="c107" value="3.  Evaluate: read validation:auc from the finished job. Deploy only if it passes the threshold (a manual gate in this lab)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="588" width="600" height="18" as="geometry"/></mxCell><mxCell id="c108" value="4.  cdk deploy -c modelDataUrl=... creates the Model, an EndpointConfig with data capture and the Endpoint." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="607" width="600" height="18" as="geometry"/></mxCell><mxCell id="c109" value="5.  The application sends one CSV row and receives a probability between 0 and 1." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="626" width="600" height="18" as="geometry"/></mxCell><mxCell id="c110" value="6.  Data capture saves each request and response under captured/, the raw material for drift analysis." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="645" width="600" height="18" as="geometry"/></mxCell><mxCell id="c111" value="7.  EventBridge starts RetrainFn every 7 days; it launches a new training job on the current data." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="664" width="600" height="18" as="geometry"/></mxCell><mxCell id="c112" value="8.  A new model repeats steps 3 and 4 with a new modelVersion. SageMaker Model Monitor is the production extension." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="683" width="600" height="18" as="geometry"/></mxCell><mxCell id="c113" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="21" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c114" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="561" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c115" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="831" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c116" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1101" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c117" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1371" y="61" width="20" height="20" as="geometry"/></mxCell><mxCell id="c118" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1101" y="261" width="20" height="20" as="geometry"/></mxCell><mxCell id="c119" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="831" y="261" width="20" height="20" as="geometry"/></mxCell><mxCell id="c120" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="561" y="261" width="20" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>