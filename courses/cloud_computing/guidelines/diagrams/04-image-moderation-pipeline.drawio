<mxfile host="app.diagrams.net"><diagram name="Guide 4: Image Moderation Pipeline" id="arch"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="818" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="aws" value="AWS Cloud (one region)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#7D8998;verticalAlign=top;align=right;spacingLeft=8;spacingRight=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="245" y="20" width="1075" height="560" as="geometry"/></mxCell><mxCell id="usr" value="upload images&lt;br&gt;JPEG or PNG" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5F6B7A;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="30" y="198" width="170" height="76" as="geometry"/></mxCell><mxCell id="usr_h" value="Users" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#5F6B7A;strokeColor=#5F6B7A;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="usr"><mxGeometry width="170" height="24" as="geometry"/></mxCell><mxCell id="s3" value="uploads/ (input, review)&lt;br&gt;published/  rejected/&lt;br&gt;encrypted, private" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="270" y="170" width="170" height="140" as="geometry"/></mxCell><mxCell id="s3_h" value="Amazon S3" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=#7AA116;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="s3"><mxGeometry width="170" height="24" as="geometry"/></mxCell><mxCell id="fn" value="Node.js 22, 512 MB&lt;br&gt;applies the policy&lt;br&gt;moves the object" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="540" y="170" width="170" height="140" as="geometry"/></mxCell><mxCell id="fn_h" value="Lambda: ModerateFn" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#ED7100;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="fn"><mxGeometry width="170" height="24" as="geometry"/></mxCell><mxCell id="rk" value="DetectModerationLabels&lt;br&gt;MinConfidence 50" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="850" y="62" width="170" height="76" as="geometry"/></mxCell><mxCell id="rk_h" value="Amazon Rekognition" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#01A88D;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="rk"><mxGeometry width="170" height="24" as="geometry"/></mxCell><mxCell id="ddb" value="decision, top label,&lt;br&gt;all labels + confidence" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C925D1;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="850" y="198" width="170" height="76" as="geometry"/></mxCell><mxCell id="ddb_h" value="DynamoDB table" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=#C925D1;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="ddb"><mxGeometry width="170" height="24" as="geometry"/></mxCell><mxCell id="sq" value="uncertain images&lt;br&gt;visibility 60 s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E7157B;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="850" y="320" width="170" height="76" as="geometry"/></mxCell><mxCell id="sq_h" value="SQS: ReviewQueue" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=#E7157B;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="sq"><mxGeometry width="170" height="24" as="geometry"/></mxCell><mxCell id="dlq" value="after 5 receives" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E7157B;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="850" y="440" width="170" height="76" as="geometry"/></mxCell><mxCell id="dlq_h" value="SQS: ReviewDlq" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=#E7157B;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="dlq"><mxGeometry width="170" height="24" as="geometry"/></mxCell><mxCell id="rev" value="polls the queue&lt;br&gt;resolves each case" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5F6B7A;strokeWidth=2;fontSize=11;fontColor=#455A64;verticalAlign=middle;spacingTop=22;" vertex="1" parent="1"><mxGeometry x="1120" y="320" width="160" height="76" as="geometry"/></mxCell><mxCell id="rev_h" value="Human reviewer" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#5F6B7A;strokeColor=#5F6B7A;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="rev"><mxGeometry width="160" height="24" as="geometry"/></mxCell><mxCell id="e0" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="usr" target="s3"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="235.0" y="236.0"/><mxPoint x="235.0" y="240.0"/></Array></mxGeometry></mxCell><mxCell id="e1" value="event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s3" target="fn"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" value="copy + delete -&gt; prefix" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="fn" target="s3"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="625.0" y="130.0"/><mxPoint x="355.0" y="130.0"/></Array></mxGeometry></mxCell><mxCell id="e3" value="detect labels" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.15;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="fn" target="rk"><mxGeometry x="0.537" relative="1" as="geometry"><Array as="points"><mxPoint x="745.0" y="191.0"/><mxPoint x="745.0" y="104.0"/></Array></mxGeometry></mxCell><mxCell id="e4" value="audit record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="fn" target="ddb"><mxGeometry x="-0.514" relative="1" as="geometry"><Array as="points"><mxPoint x="780.0" y="240.0"/><mxPoint x="780.0" y="236.0"/></Array></mxGeometry></mxCell><mxCell id="e5" value="only if 60-89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.85;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="fn" target="sq"><mxGeometry x="0.507" relative="1" as="geometry"><Array as="points"><mxPoint x="745.0" y="289.0"/><mxPoint x="745.0" y="362.0"/></Array></mxGeometry></mxCell><mxCell id="e6" value="poison msgs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="sq" target="dlq"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e7" value="poll" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;strokeColor=#37474F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="sq" target="rev"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e8" value="reviewer moves the object and updates the audit item" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;strokeWidth=1.6;dashed=1;strokeColor=#37474F;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="rev" target="s3"><mxGeometry x="-0.071" relative="1" as="geometry"><Array as="points"><mxPoint x="1200.0" y="540.0"/><mxPoint x="355.0" y="540.0"/></Array></mxGeometry></mxCell><mxCell id="c101" value="Policy on the highest confidence" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="488" width="600" height="18" as="geometry"/></mxCell><mxCell id="c102" value="&gt;= 90   BLOCKED  -&gt; rejected/" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="24" y="508" width="600" height="18" as="geometry"/></mxCell><mxCell id="c103" value="60-89   NEEDS_REVIEW  -&gt; SQS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="24" y="526" width="600" height="18" as="geometry"/></mxCell><mxCell id="c104" value="&lt; 60   PUBLISHED  -&gt; published/" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="24" y="544" width="600" height="18" as="geometry"/></mxCell><mxCell id="c105" value="Guide 4: Image Moderation Pipeline" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="13" width="600" height="23" as="geometry"/></mxCell><mxCell id="c106" value="Solid arrow: call or data write   |   Dashed arrow: trigger, async event or optional path   |   Numbered circles match the Flow list" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="24" y="587" width="600" height="17" as="geometry"/></mxCell><mxCell id="c107" value="Flow" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="607" width="600" height="19" as="geometry"/></mxCell><mxCell id="c108" value="1.  A user uploads an image to uploads/." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="630" width="600" height="18" as="geometry"/></mxCell><mxCell id="c109" value="2.  S3 ObjectCreated invokes ModerateFn (the other prefixes have no trigger, so moving a file never re-invokes it)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="649" width="600" height="18" as="geometry"/></mxCell><mxCell id="c110" value="3.  Rekognition returns moderation labels with a confidence. A non-image or oversized file cannot be checked and goes to review (fail closed)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="668" width="600" height="18" as="geometry"/></mxCell><mxCell id="c111" value="4.  The policy compares the highest confidence with two thresholds that are environment variables." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="687" width="600" height="18" as="geometry"/></mxCell><mxCell id="c112" value="5.  Clear cases are moved (copy, then delete) to published/ or rejected/. Uncertain images stay in uploads/." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="706" width="600" height="18" as="geometry"/></mxCell><mxCell id="c113" value="6.  Uncertain images are sent to the review queue; messages that keep failing move to the dead-letter queue." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="725" width="600" height="18" as="geometry"/></mxCell><mxCell id="c114" value="7.  Every decision is stored in DynamoDB with all labels, so each automated decision can be audited." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="744" width="600" height="18" as="geometry"/></mxCell><mxCell id="c115" value="8.  A reviewer polls the queue and finishes the case by hand (s3 mv + update the audit item)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="24" y="763" width="600" height="18" as="geometry"/></mxCell><mxCell id="c116" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="21" y="189" width="20" height="20" as="geometry"/></mxCell><mxCell id="c117" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="531" y="161" width="20" height="20" as="geometry"/></mxCell><mxCell id="c118" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="841" y="53" width="20" height="20" as="geometry"/></mxCell><mxCell id="c119" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="841" y="189" width="20" height="20" as="geometry"/></mxCell><mxCell id="c120" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="841" y="311" width="20" height="20" as="geometry"/></mxCell><mxCell id="c121" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1111" y="311" width="20" height="20" as="geometry"/></mxCell><mxCell id="c122" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="689" y="161" width="20" height="20" as="geometry"/></mxCell><mxCell id="c123" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="419" y="161" width="20" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>